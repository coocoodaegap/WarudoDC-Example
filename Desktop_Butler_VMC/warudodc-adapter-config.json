  "calls": [
    {
      "id": "b22a4265ee3e816d375b90058f32a1d3",
      "name": "移动至目的地",
      "enabled": true,
      "call_name": "autonomy_move_to",
      "api_key": "autonomy.move_to",
      "description": "请求角色自主移动到目标世界坐标；最终是否执行由主场景 Autonomy Controller 决定。参考范围：水平方向 x ∈ [-1, 1]",
      "parameter_descriptions": {
        "target": ""
      },
      "schema": {
        "request_fields": [
          {
            "key": "target",
            "kind": "vector3"
          }
        ]
      },
      "result_api_key": "autonomy.move_to.result",
      "result_timeout_ms": 30000,
      "result_schema": {
        "request_fields": [
          {
            "key": "status",
            "kind": "string"
          },
          {
            "key": "position",
            "kind": "vector3"
          }
        ]
      }
    },
    {
