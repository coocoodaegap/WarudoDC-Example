            "kind": "string"
          }
        ]
      }
    },
    {
      "id": "2cbc20dcb57750a9969a3cae21938b94",
      "name": "转向指定朝向",
      "enabled": true,
      "call_name": "autonomy_rotate_to",
      "api_key": "autonomy.rotate_to",
      "description": "需要让角色面向指定的世界水平角度时使用。yaw 为世界 Y 轴角度（度），范围 [0,360]；不是相对角度，不移动位置。仅按明确意图选择，不要凭空把某个角度当作面向用户。实际执行受蓝图的交互与自主行动守卫控制。等待独立结果后，只有 status=completed 才可声称完成；超时或未知不能视作成功，也不要自动重复执行。",
      "parameter_descriptions": {
        "yaw": "世界水平朝向（度），限制 [0,360]。"
      },
      "schema": {
        "request_fields": [
          {
            "key": "yaw",
            "kind": "float"
          }
        ]
      },
      "result_api_key": "autonomy.rotate_to.result",
      "result_timeout_ms": 30000,
      "result_schema": {
        "request_fields": [
          {
            "key": "rotation",
            "kind": "vector3"
          },
          {
            "key": "status",
            "kind": "string"
          }
        ]
      }
    },
    {
      "id": "58de4fae293052bbb7e1fa8321375707",
      "name": "相对当前朝向转动",
      "enabled": true,
      "call_name": "autonomy_rotate_by",
      "api_key": "autonomy.rotate_by",
      "description": "需要让角色在当前位置相对当前水平朝向转动时使用。delta_yaw 为绕世界 Y 轴的角度增量（度），范围 [-180,180]；不是绝对朝向，也不平移角色，不支持绕多圈。实际执行受蓝图的交互与自主行动守卫控制。等待独立结果后，只有 status=completed 才可声称完成；超时或未知不能视作成功，也不要自动重复执行。",
      "parameter_descriptions": {
        "delta_yaw": "相对当前水平朝向的增量（度），限制 [-180,180]，走最短路径。"
